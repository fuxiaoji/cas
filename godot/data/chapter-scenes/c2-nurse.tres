[gd_resource type="Resource" script_class="CasChapterSceneVisual" load_steps=24 format=3]

[ext_resource type="Script" path="res://scripts/chapter_scene_resource.gd" id="1_scene"]

[ext_resource type="Script" path="res://scripts/chapter_line_resource.gd" id="2_line"]

[sub_resource type="Resource" id="Line_0"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="医棚的护士来取修好的扬声器，衣领上有你们刚在中继处见过的教团记号。你盯得太久，她把布包换到另一只手，问是不是记号扎到眼了。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={}

[sub_resource type="Resource" id="Line_1"]

script=ExtResource("2_line")

speaker=""

speaker_name="你"

text="对不起。我在想怎么问才不显得——"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={}

[sub_resource type="Resource" id="Line_2"]

script=ExtResource("2_line")

speaker="护士"

speaker_name=""

text="想问就问。我不保证每件都知道，但你不用替我把问题磨圆到没剩内容。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={}

[sub_resource type="Resource" id="Line_3"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="她叫岑医生，其实还没拿到完整医师资格。人们习惯这么叫，她会答应，也会在做不了的检查前说清楚。德雷顿问她能不能先看看自己的手腕，她让她坐下，先把装扬声器的包垫稳。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={}

[sub_resource type="Resource" id="Line_4"]

script=ExtResource("2_line")

speaker="岑医生"

speaker_name=""

text="什么时候开始疼？不是最近，是哪次动作以后。你自己觉得不重要的那一下，也说。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={}

[sub_resource type="Resource" id="Line_5"]

script=ExtResource("2_line")

speaker="drayton"

speaker_name=""

text="昨晚拉人的时候。今天还能动，就是拧东西会酸。"

tone="hurt"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={"drayton": "hurt"}

[sub_resource type="Resource" id="Line_6"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="她检查时没有念祷词，也没要求德雷顿同意任何不明的接入。你终于问出口，知不知道交换站的记录被开门派改过。她停了一瞬，让德雷顿先别动手。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={"drayton": "hurt"}

[sub_resource type="Resource" id="Line_7"]

script=ExtResource("2_line")

speaker="岑医生"

speaker_name=""

text="听说过。没见过你们带回来的原件。我见过的是医棚收到的新流程，有一段我没有按。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={"drayton": "hurt"}

[sub_resource type="Resource" id="Line_8"]

script=ExtResource("2_line")

speaker=""

speaker_name="你"

text="哪一段？"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={"drayton": "hurt"}

[sub_resource type="Resource" id="Line_9"]

script=ExtResource("2_line")

speaker="岑医生"

speaker_name=""

text="让伤员先登记完整的旧身份，再给临时止痛。我不干。疼着的人说不清，不代表该疼着等。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={"drayton": "hurt"}

[sub_resource type="Resource" id="Line_10"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="她从包里取出那份流程，删去的部分用横线标着，边上有自己的签名。她说不是自己多勇敢，是上一个来接班的人会问为什么给了药，总得留下一份自己愿意负责的答案。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={"drayton": "hurt"}

[sub_resource type="Resource" id="Line_11"]

script=ExtResource("2_line")

speaker=""

speaker_name="你"

text="你不怕他们找你？"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={"drayton": "hurt"}

[sub_resource type="Resource" id="Line_12"]

script=ExtResource("2_line")

speaker="岑医生"

speaker_name=""

text="怕。所以还在找能一起承担的人。怕不是假的，签字也不是。你要引用这份记录，得先告诉我放到哪里，别让我从广播里才知道自己被说成了什么人。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={"drayton": "hurt"}

[sub_resource type="Resource" id="Line_13"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="你问她是否愿意在私下交接给旧金山，她想了想，同意了。她不同意把住址一并写进公开名单，也不希望你们用“教团良心”这样的词去替她做一个好听的招牌。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={"drayton": "hurt"}

[sub_resource type="Resource" id="Line_14"]

script=ExtResource("2_line")

speaker="岑医生"

speaker_name=""

text="我还有不少做得糟的事。上个月把药算错了两瓶，害隔壁临时去借。你要是只写我这一回，别人以后就不好意思来骂我，那我更改不掉。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={"drayton": "hurt"}

[sub_resource type="Resource" id="Line_15"]

script=ExtResource("2_line")

speaker="drayton"

speaker_name=""

text="这个我支持。她刚才把我的伤说得很严重，害我不能继续拧螺丝。我打算回来骂一次。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={"drayton": "calm"}

[sub_resource type="Resource" id="Line_16"]

script=ExtResource("2_line")

speaker="岑医生"

speaker_name=""

text="可以，别用伤手推门。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={"drayton": "calm"}

[sub_resource type="Resource" id="Line_17"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="你们都笑了。岑医生把绑带扎得整齐，又让德雷顿自己试几个不会伤到的动作。她离开时，教团的记号仍在衣领上，你却终于能把它和眼前这个有名字、有边界的人分开记。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={"drayton": "calm"}

[sub_resource type="Resource" id="Line_18"]

script=ExtResource("2_line")

speaker=""

speaker_name="你"

text="我会把流程怎么处理回报给你，不只说一句谢谢。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={"drayton": "calm"}

[sub_resource type="Resource" id="Line_19"]

script=ExtResource("2_line")

speaker="岑医生"

speaker_name=""

text="谢谢也可以说。就是别拿它替代后面的事。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={"drayton": "calm"}

[sub_resource type="Resource" id="Line_20"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="她抱起修好的扬声器，先当着你们试了一遍，确认能听见普通的医棚回报，才把防雨布盖上。外面下着小雨，她挨户提醒孩子别在新开的阀门旁玩，没有一条提醒需要谁先接受她的信仰。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={"drayton": "calm"}

