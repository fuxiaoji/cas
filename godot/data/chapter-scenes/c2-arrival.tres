[gd_resource type="Resource" script_class="CasChapterSceneVisual" load_steps=22 format=3]

[ext_resource type="Script" path="res://scripts/chapter_scene_resource.gd" id="1_scene"]

[ext_resource type="Script" path="res://scripts/chapter_line_resource.gd" id="2_line"]

[sub_resource type="Resource" id="Line_0"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="堤道没有一块完整的陆地。退役船壳首尾接起来，窄桥从别人家的厨房门前穿过。你们到的时候，一个老人正蹲在桥边，用麻绳把一张椅子重新绑紧。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_1"]

script=ExtResource("2_line")

speaker="drayton"

speaker_name=""

text="别问椅子为什么不能搬进去。他会从三年前那场风暴开始讲，我们午饭前都下不了船。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_2"]

script=ExtResource("2_line")

speaker=""

speaker_name="你"

text="你问过？"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_3"]

script=ExtResource("2_line")

speaker="drayton"

speaker_name=""

text="我还帮他搬过。第二天又出来了。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_4"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="老人抬头向她挥手，手里仍攥着绳子。你看见椅脚下面有两道很深的磨痕，一道旧，一道新，像这些船壳也是一点点被人拴在一起的。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_5"]

script=ExtResource("2_line")

speaker="fletcher"

speaker_name=""

text="我们送净水膜来，回程带一批灯芯。先确认交接点，再检查外面的航路。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_6"]

script=ExtResource("2_line")

speaker="perkins"

speaker_name=""

text="昨天的求救信号还在重复。整点前后各一遍，一个字都不差。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_7"]

script=ExtResource("2_line")

speaker=""

speaker_name="你"

text="会不会是自动发送？"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_8"]

script=ExtResource("2_line")

speaker="perkins"

speaker_name=""

text="可能。所以我才没把“有人活着”写进简报。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_9"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="一个穿胶靴的男孩把栈桥上的水扫进海里，扫完一段，另一段又被浪打湿。他看了看你，又看了看你的空胸牌，问德雷顿是不是又捡了个人回来。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_10"]

script=ExtResource("2_line")

speaker="drayton"

speaker_name=""

text="这次捡得挺大。你家的锅够用吗？"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_11"]

script=ExtResource("2_line")

speaker=""

speaker_name="男孩"

text="够。就是没鱼了。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_12"]

script=ExtResource("2_line")

speaker=""

speaker_name="你"

text="我不会钓鱼。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_13"]

script=ExtResource("2_line")

speaker=""

speaker_name="男孩"

text="也没叫你钓。会把桶拎上去就行。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_14"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="他把桶柄递给你，很自然地松了手。桶比你预想的重，你向前晃了一下。弗莱彻替你扶住桥边的绳，没接过桶，等你自己站稳。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_15"]

script=ExtResource("2_line")

speaker=""

speaker_name="你"

text="每次都要这样来回拎？"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_16"]

script=ExtResource("2_line")

speaker=""

speaker_name="男孩"

text="以前有泵。现在等下面那台机器放行。它高兴就放，不高兴就让人等。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_17"]

script=ExtResource("2_line")

speaker="perkins"

speaker_name=""

text="机器不会高兴。它的阀门怎么接，谁让它开，我们得查清楚。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_18"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="你跟着他们往里走。桥下的水中还看得见街道护栏，护栏外面挂着窗帘，一点一点往更深处摆。这里每户人家的门口，都比从前的屋顶更高。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

