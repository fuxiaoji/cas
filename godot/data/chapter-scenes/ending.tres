[gd_resource type="Resource" script_class="CasChapterSceneVisual" load_steps=21 format=3]

[ext_resource type="Script" path="res://scripts/chapter_scene_resource.gd" id="1_scene"]

[ext_resource type="Script" path="res://scripts/chapter_line_resource.gd" id="2_line"]

[sub_resource type="Resource" id="Line_0"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="旧金山的办公室还亮着灯。她把原档案放进铁柜，留在桌上的只是那张维修单。纸张翻过来，背面有一个和计时器一样的旧印记。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["sanfrancisco", "tideborn"])

actor_tones={}

[sub_resource type="Resource" id="Line_1"]

script=ExtResource("2_line")

speaker="sanfrancisco"

speaker_name=""

text="这次不是重发的旧信号。有人在现场看着他们。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["sanfrancisco", "tideborn"])

actor_tones={}

[sub_resource type="Resource" id="Line_2"]

script=ExtResource("2_line")

speaker="tideborn"

speaker_name=""

text="他也听见了？"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["sanfrancisco", "tideborn"])

actor_tones={}

[sub_resource type="Resource" id="Line_3"]

script=ExtResource("2_line")

speaker="sanfrancisco"

speaker_name=""

text="他说记不起来。我相信他。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["sanfrancisco", "tideborn"])

actor_tones={}

[sub_resource type="Resource" id="Line_4"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="潮痕站在窗边，没有去碰桌上的灯。雨从玻璃外面流下来，把港口切成许多相近又不同的碎片。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["sanfrancisco", "tideborn"])

actor_tones={}

[sub_resource type="Resource" id="Line_5"]

script=ExtResource("2_line")

speaker="tideborn"

speaker_name=""

text="你相信他不记得，还是相信他不会做以前做过的事？"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["sanfrancisco", "tideborn"])

actor_tones={}

[sub_resource type="Resource" id="Line_6"]

script=ExtResource("2_line")

speaker="sanfrancisco"

speaker_name=""

text="我没说后面那句。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["sanfrancisco", "tideborn"])

actor_tones={}

[sub_resource type="Resource" id="Line_7"]

script=ExtResource("2_line")

speaker="tideborn"

speaker_name=""

text="那你为什么签字？"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["sanfrancisco", "tideborn"])

actor_tones={}

[sub_resource type="Resource" id="Line_8"]

script=ExtResource("2_line")

speaker="sanfrancisco"

speaker_name=""

text="因为我知道一个人醒来时什么都不记得是什么样。你也知道。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["sanfrancisco", "tideborn"])

actor_tones={}

[sub_resource type="Resource" id="Line_9"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="潮痕垂下眼。她手里那只旧表没有表针，表面却擦得很干净。旧金山看见了，没再说下去，先把窗缝塞住。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["sanfrancisco", "tideborn"])

actor_tones={}

[sub_resource type="Resource" id="Line_10"]

script=ExtResource("2_line")

speaker="tideborn"

speaker_name=""

text="如果那道门真的还认得他，你藏不住太久。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["sanfrancisco", "tideborn"])

actor_tones={}

[sub_resource type="Resource" id="Line_11"]

script=ExtResource("2_line")

speaker="sanfrancisco"

speaker_name=""

text="我知道。我至少要让他在被人问“你是谁”之前，有机会知道自己愿意做谁。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["sanfrancisco", "tideborn"])

actor_tones={}

[sub_resource type="Resource" id="Line_12"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="灯下的纸压住一小截红线。旧金山最终没有把它一起锁进柜子，而是装进一个新的证物袋，在背面写下今天的日期。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["sanfrancisco", "tideborn"])

actor_tones={}

[sub_resource type="Resource" id="Line_13"]

script=ExtResource("2_line")

speaker="tideborn"

speaker_name=""

text="下一份记录呢？"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["sanfrancisco", "tideborn"])

actor_tones={}

[sub_resource type="Resource" id="Line_14"]

script=ExtResource("2_line")

speaker="sanfrancisco"

speaker_name=""

text="沉钟交换站。第五队会经过那条航路。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["sanfrancisco", "tideborn"])

actor_tones={}

[sub_resource type="Resource" id="Line_15"]

script=ExtResource("2_line")

speaker="tideborn"

speaker_name=""

text="你打算告诉她们多少？"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["sanfrancisco", "tideborn"])

actor_tones={}

[sub_resource type="Resource" id="Line_16"]

script=ExtResource("2_line")

speaker="sanfrancisco"

speaker_name=""

text="先告诉她们航路上住着人。至于我欠的话，不能再用任务简报代替。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["sanfrancisco", "tideborn"])

actor_tones={}

[sub_resource type="Resource" id="Line_17"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="走廊外有人轻轻敲门，说医务室的名单已经齐了。旧金山应了一声，把“来历不明”那张表移到一边，先去确认每个人有没有领到干净的床单。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["sanfrancisco", "tideborn"])

actor_tones={}

