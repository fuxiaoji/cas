[gd_resource type="Resource" script_class="CasChapterSceneVisual" load_steps=20 format=3]

[ext_resource type="Script" path="res://scripts/chapter_scene_resource.gd" id="1_scene"]

[ext_resource type="Script" path="res://scripts/chapter_line_resource.gd" id="2_line"]

[sub_resource type="Resource" id="Line_0"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="真正离开堤道以前，你们又去了一趟供水站。阀门上的新标记没有掉，末端的白碗也还在，只是旁边多了几道孩子用石头画的刻痕。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_1"]

script=ExtResource("2_line")

speaker=""

speaker_name="你"

text="不是说别随便改标记吗？"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_2"]

script=ExtResource("2_line")

speaker="管事"

speaker_name=""

text="他没改阀门，画的是自己每天搬了几趟。怕和工账混，我正想给他换块地方。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_3"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="男孩拿着石头站在旁边，脸上写着准备挨骂。你把空木板递给他，让他先说明想记什么，再决定怎么分。最后他把自己的趟数画到旁边，给公共刻度留出距离。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_4"]

script=ExtResource("2_line")

speaker="drayton"

speaker_name=""

text="这回你也有工作记录了。别忘了把休息的那天也空出来，不用为了排得好看补一趟。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_5"]

script=ExtResource("2_line")

speaker=""

speaker_name="男孩"

text="我又不傻。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_6"]

script=ExtResource("2_line")

speaker="drayton"

speaker_name=""

text="我小时候补过。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_7"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="他终于笑了。你把末端的水色和流量报给拉姆森，听见她在另一头确认密封暂时稳定。今早来接班的工人能复述处理步骤，不用你们一直守在这里解释。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_8"]

script=ExtResource("2_line")

speaker=""

speaker_name="你"

text="我们可以走了？"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_9"]

script=ExtResource("2_line")

speaker="fletcher"

speaker_name=""

text="可以。不是没有后续问题，是留下的人已经知道问题和接法。下回路过再核，不用为了安心把每件事都攥到自己船上。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_10"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="旧金山发来灯塔的交接图，图上没有写主角的身世，只标了接收端和检修路。你把它放进夹板，没让它盖住刚完成的这一页。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_11"]

script=ExtResource("2_line")

speaker="perkins"

speaker_name=""

text="先完成这边的交班。新的任务等回船再说。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_12"]

script=ExtResource("2_line")

speaker=""

speaker_name="你"

text="知道了。水站工单交给谁，备件哪天到，原档案谁保管。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_13"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="你一项项确认，等最后一个人签名，才合上记录。一个女人把洗干净的白碗放进篮里，说你们下次来还用它。她没有保证下一次一定是什么好天气。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_14"]

script=ExtResource("2_line")

speaker="drayton"

speaker_name=""

text="雨大的时候先找锅，别先找我们。我们看见信号会回，但不一定每次都来得及。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_15"]

script=ExtResource("2_line")

speaker=""

speaker_name="女人"

text="知道。你们路上也别为了让我们放心，把没走过的路说成好走。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_16"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="船离开时，你看见老人重新给椅子系绳。男孩没有站在桥头挥很久，跑回公共屋，和另一个孩子争谁先用那块画板。你们带走了灯芯、原件和未解的问题，也留下了一点不用你们在场仍能继续的日子。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

