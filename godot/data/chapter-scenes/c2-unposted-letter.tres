[gd_resource type="Resource" script_class="CasChapterSceneVisual" load_steps=22 format=3]

[ext_resource type="Script" path="res://scripts/chapter_scene_resource.gd" id="1_scene"]

[ext_resource type="Script" path="res://scripts/chapter_line_resource.gd" id="2_line"]

[sub_resource type="Resource" id="Line_0"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="保管员把那封没有寄出的信放到你面前，问你们是不是要当作档案一起公开。信封上只写着“等水位降下去”，没有收件人的名字。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["perkins", "drayton", "sanfrancisco"])

actor_tones={}

[sub_resource type="Resource" id="Line_1"]

script=ExtResource("2_line")

speaker=""

speaker_name="你"

text="先别拆新的封口。我们需要知道里面有没有和同步记录有关的内容，不等于所有私人话都该拿出来。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["perkins", "drayton", "sanfrancisco"])

actor_tones={}

[sub_resource type="Resource" id="Line_2"]

script=ExtResource("2_line")

speaker="perkins"

speaker_name=""

text="已经有一面破开。能确认的先按原样拍，其他部分封住，记谁经手。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["perkins", "drayton", "sanfrancisco"])

actor_tones={}

[sub_resource type="Resource" id="Line_3"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="露出来的那一小段没有任何参数。写信的人说已经把花盆移到高处，若对方回来，先别骂窗子没关，因为自己留了一道缝，怕屋里太闷。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["perkins", "drayton", "sanfrancisco"])

actor_tones={}

[sub_resource type="Resource" id="Line_4"]

script=ExtResource("2_line")

speaker="drayton"

speaker_name=""

text="像一封出门前留的纸条。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["perkins", "drayton", "sanfrancisco"])

actor_tones={}

[sub_resource type="Resource" id="Line_5"]

script=ExtResource("2_line")

speaker=""

speaker_name="你"

text="也可能他一直以为只走几天。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["perkins", "drayton", "sanfrancisco"])

actor_tones={}

[sub_resource type="Resource" id="Line_6"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="你们都没有继续往下读。保管员用一张薄纸盖住露出的字，问有没有人知道那一片旧住区还剩什么。旧金山在频道里说，她可以查旧地址，但要先确认写信的人是不是还活着。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["perkins", "drayton", "sanfrancisco"])

actor_tones={}

[sub_resource type="Resource" id="Line_7"]

script=ExtResource("2_line")

speaker="sanfrancisco"

speaker_name=""

text="如果当事人能自己回答，就不该因为这封信进了我们的箱子，就让我们替他回答。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["perkins", "drayton", "sanfrancisco"])

actor_tones={}

[sub_resource type="Resource" id="Line_8"]

script=ExtResource("2_line")

speaker=""

speaker_name="你"

text="你以前也这样处理过吗？"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["perkins", "drayton", "sanfrancisco"])

actor_tones={}

[sub_resource type="Resource" id="Line_9"]

script=ExtResource("2_line")

speaker="sanfrancisco"

speaker_name=""

text="有时做到，有时没有。我不能说现在做对一次，就把以前没做对的那部分抹掉。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["perkins", "drayton", "sanfrancisco"])

actor_tones={}

[sub_resource type="Resource" id="Line_10"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="她主动交出一页旧移交记录。上面有几个人的名字被划去，备注是“无关，转存”。你问转存到哪里，她说正在查，如果查不到，也会留下这份缺口。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["perkins", "drayton", "sanfrancisco"])

actor_tones={}

[sub_resource type="Resource" id="Line_11"]

script=ExtResource("2_line")

speaker="drayton"

speaker_name=""

text="我小时候觉得大人都知道，只是不肯说。后来才知道，不肯说和不知道，听起来很像。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["perkins", "drayton", "sanfrancisco"])

actor_tones={}

[sub_resource type="Resource" id="Line_12"]

script=ExtResource("2_line")

speaker=""

speaker_name="你"

text="现在能分清了？"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["perkins", "drayton", "sanfrancisco"])

actor_tones={}

[sub_resource type="Resource" id="Line_13"]

script=ExtResource("2_line")

speaker="drayton"

speaker_name=""

text="也不能。但我会问他愿不愿意一起查。不愿意的话，再听多好听的话都没用。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["perkins", "drayton", "sanfrancisco"])

actor_tones={}

[sub_resource type="Resource" id="Line_14"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="你把信封翻到背面，看见一个很小的手指印，可能来自吃饭，也可能来自检修留下的油。你没有像以前那样把它想象成告别，只记录了可见的痕迹。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["perkins", "drayton", "sanfrancisco"])

actor_tones={}

[sub_resource type="Resource" id="Line_15"]

script=ExtResource("2_line")

speaker="perkins"

speaker_name=""

text="这封信不归我们个人。原件入保管，定位和索引留给寻人组。没找到收件人之前，不要拿里面的话到处讲。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["perkins", "drayton", "sanfrancisco"])

actor_tones={}

[sub_resource type="Resource" id="Line_16"]

script=ExtResource("2_line")

speaker=""

speaker_name="你"

text="我们能帮什么？"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["perkins", "drayton", "sanfrancisco"])

actor_tones={}

[sub_resource type="Resource" id="Line_17"]

script=ExtResource("2_line")

speaker="sanfrancisco"

speaker_name=""

text="把从哪里带回、旁边有什么、哪些部分没动过，说清楚。剩下的让接班的人接。你不需要在一趟航次里把每个结尾都找到。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["perkins", "drayton", "sanfrancisco"])

actor_tones={}

[sub_resource type="Resource" id="Line_18"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="保管员在封条上签名，让你们确认名字没有写错。你看她把信放进抽屉，心里仍有一点想知道完整内容的冲动，却终于能让这点冲动跟着抽屉一起关上。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["perkins", "drayton", "sanfrancisco"])

actor_tones={}

