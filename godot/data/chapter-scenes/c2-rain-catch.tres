[gd_resource type="Resource" script_class="CasChapterSceneVisual" load_steps=20 format=3]

[ext_resource type="Script" path="res://scripts/chapter_scene_resource.gd" id="1_scene"]

[ext_resource type="Script" path="res://scripts/chapter_line_resource.gd" id="2_line"]

[sub_resource type="Resource" id="Line_0"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="等回接命令的时候，雨忽然大起来。屋顶上几条折叠水槽被人推开，原本各自倾斜的铁皮一起把水送进同一个罐。男孩抱着一把刷子，踮脚去够入口的落叶。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={}

[sub_resource type="Resource" id="Line_1"]

script=ExtResource("2_line")

speaker=""

speaker_name="你"

text="我帮你。要把这些都刷进去吗？"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={}

[sub_resource type="Resource" id="Line_2"]

script=ExtResource("2_line")

speaker=""

speaker_name="男孩"

text="刷出去！那边流进罐，前面这段还不能用。你看，阀没转。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={}

[sub_resource type="Resource" id="Line_3"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="管事过来给你看刻在侧边的标记。刚开始落下的雨要先冲掉屋顶积灰，等专门值守的人确认，才把水引入储罐。不是从天上下来的，就一定干净。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={}

[sub_resource type="Resource" id="Line_4"]

script=ExtResource("2_line")

speaker="drayton"

speaker_name=""

text="他第一次帮忙也弄错过。后来被安排抱着刷子看三次，现在比谁都认真。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={}

[sub_resource type="Resource" id="Line_5"]

script=ExtResource("2_line")

speaker=""

speaker_name="男孩"

text="你也弄错过。上回你把空桶放到满桶那边。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={}

[sub_resource type="Resource" id="Line_6"]

script=ExtResource("2_line")

speaker="drayton"

speaker_name=""

text="我承认。所以现在先问你，哪个该搬？"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={}

[sub_resource type="Resource" id="Line_7"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="他认真指给你们看。满桶的盖子扣紧，空桶先检查内壁，裂过的桶箍上系两段绳。你以为只是大人随手分的工，做起来才发现每个记号都对应一件真正出过的问题。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={}

[sub_resource type="Resource" id="Line_8"]

script=ExtResource("2_line")

speaker=""

speaker_name="你"

text="等雨停了，这些水要分给谁？"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={}

[sub_resource type="Resource" id="Line_9"]

script=ExtResource("2_line")

speaker="管事"

speaker_name=""

text="先公共用水，剩下按户登记。谁值了班不多领，但记在工账里，月底抵手工费。不能让没力气上屋顶的人一直没水喝。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={}

[sub_resource type="Resource" id="Line_10"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="一位瘸腿老人坐在屋檐下记桶数，写满一页就念给另一个人听。你去搬桶，他还提醒你别因为怕打断说话，一次抱两只，摔坏了反而忙不过来。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={}

[sub_resource type="Resource" id="Line_11"]

script=ExtResource("2_line")

speaker=""

speaker_name="你"

text="这些办法是谁想的？"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={}

[sub_resource type="Resource" id="Line_12"]

script=ExtResource("2_line")

speaker=""

speaker_name="老人"

text="好些人。以前有人想过，后来有人忘了，再后来摔了桶，大家又想起来。你要问一个名字，我们真没法只挑一个。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={}

[sub_resource type="Resource" id="Line_13"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="雨渐渐小了，大家把水槽收回，免得下一阵大风把它们掀走。男孩发现少了一把刷子，急得脸红，你从水罐背面找到，刷柄正好卡在一条缝里。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={}

[sub_resource type="Resource" id="Line_14"]

script=ExtResource("2_line")

speaker="drayton"

speaker_name=""

text="好了，今天可以记“没丢”。我替你作证。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={}

[sub_resource type="Resource" id="Line_15"]

script=ExtResource("2_line")

speaker=""

speaker_name="男孩"

text="本来就没丢！"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={}

[sub_resource type="Resource" id="Line_16"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="你把多出来的那张记录纸擦干，放在桌角。纸里没有古老权限，也没有秘密，只记今天这场雨最后接到了多少能用的水。你看见它和档案一样，被折好、签名、留给下一班。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton"])

actor_tones={}

