[sub_resource type="Resource" id="Line_43"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="你把小瓶那一行抄进自己的记录，旁边没有写价格。海图上的一个接近点，忽然多了两个人、一条不太好走的楼梯和一罐需要松着盖的面种。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["fletcher", "drayton", "perkins"])

actor_tones={"tideborn": "concern"}

[sub_resource type="Resource" id="Line_44"]

script=ExtResource("2_line")

speaker=""

speaker_name="你"

text="我去扶。外侧让潮痕看，她更熟那里。要是那位邻居仍然不想走，就先问她缺什么，不急着替这一趟写个结果。"

tone="calm"

shot="wide"

