[gd_resource type="Resource" script_class="CasChapterSceneVisual" load_steps=22 format=3]

[ext_resource type="Script" path="res://scripts/chapter_scene_resource.gd" id="1_scene"]

[ext_resource type="Script" path="res://scripts/chapter_line_resource.gd" id="2_line"]

[sub_resource type="Resource" id="Line_0"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="绳索绷紧时，你没听见断裂的声音。你只看见男孩手里的铁盒一下飞出去，灯芯洒在甲板上，像一小群来不及飞走的黑鸟。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_1"]

script=ExtResource("2_line")

speaker="drayton"

speaker_name=""

text="别追盒子！抓我！"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_2"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="弗莱彻从另一边扑过去，半个身子压在桥边。她拽住德雷顿的后领，德雷顿的手却差了很短一截。你把身上的救生绳解下来，沿着她手臂送过去。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_3"]

script=ExtResource("2_line")

speaker=""

speaker_name="你"

text="套上手腕。看着我，不用看水。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_4"]

script=ExtResource("2_line")

speaker=""

speaker_name="男孩"

text="我的盒子——"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_5"]

script=ExtResource("2_line")

speaker=""

speaker_name="你"

text="盒子在。先把手给我。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_6"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="他终于松开抱着的断木，抓住了绳。德雷顿把人拉上来，自己却被反冲拖得跪在地上。弗莱彻一直没松手，直到男孩能开口哭了才慢慢坐下。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_7"]

script=ExtResource("2_line")

speaker="fletcher"

speaker_name=""

text="还有谁没过来？"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_8"]

script=ExtResource("2_line")

speaker="perkins"

speaker_name=""

text="都到了。维修艇在回收浮桥，外侧没有新的接触。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_9"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="男孩哭得直打嗝，反复说母亲会骂他。德雷顿捡起几根能用的灯芯，塞进他袖子，让他替自己数一下，好让哭声暂时停下来。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_10"]

script=ExtResource("2_line")

speaker=""

speaker_name="你"

text="他刚才是不是已经在我们后面了？我应该早一点让你们——"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_11"]

script=ExtResource("2_line")

speaker="fletcher"

speaker_name=""

text="断的是岸上的旧桩，不是你画的路线。现在先别替所有事领责任。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_12"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="她的手在抖，抖得连壶盖都拧不开。你帮她拧开时，才发现她指节下面已经磨破。德雷顿看见了，没说话，把自己干一点的袖口撕下来。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_13"]

script=ExtResource("2_line")

speaker="drayton"

speaker_name=""

text="下回别抓领子。我都快以为你要把我勒回去了。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_14"]

script=ExtResource("2_line")

speaker="fletcher"

speaker_name=""

text="下回别只剩领子让我抓。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_15"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="两个人都笑了一下，笑得有点累。男孩终于数完，说一共有七根，最后一根湿了但还能晒。你们没有纠正其实有八根，让他把铁盒重新扣上。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_16"]

script=ExtResource("2_line")

speaker=""

speaker_name="你"

text="原来“都到了”得一个一个看见才算。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_17"]

script=ExtResource("2_line")

speaker="perkins"

speaker_name=""

text="嗯。所以我刚才没有回答“应该”。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

[sub_resource type="Resource" id="Line_18"]

script=ExtResource("2_line")

speaker=""

speaker_name=""

text="临走前，女人把半杯水重新倒满。你没再推回去。杯子底下压着那半截带牙印的铅笔，你把它拿起来，写下了维修艇的名字。"

tone="calm"

shot="wide"

motion="none"

text_effect="none"

characters_per_second=34.0

caption=""

actors=Array[String](["drayton", "fletcher", "perkins"])

actor_tones={}

