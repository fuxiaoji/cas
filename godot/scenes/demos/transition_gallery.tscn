[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scenes/demos/transition_gallery.gd" id="1_demo"]
[ext_resource type="PackedScene" path="res://scenes/ui/page_transition.tscn" id="2_transition"]
[ext_resource type="FontFile" path="res://assets/fonts/NotoSansSC.ttf" id="3_font"]

[sub_resource type="Theme" id="Theme_gallery"]
default_font=ExtResource("3_font")
default_font_size=22
Label/colors/font_color=Color(0.91,0.95,0.94,1)
Button/font_sizes/font_size=24
Button/constants/outline_size=0

[node name="TransitionGallery" type="Control"]
layout_mode=3
anchors_preset=15
anchor_right=1.0
anchor_bottom=1.0
grow_horizontal=2
grow_vertical=2
theme=SubResource("Theme_gallery")
script=ExtResource("1_demo")

[node name="Backdrop" type="Control" parent="."]
layout_mode=1
anchors_preset=15
anchor_right=1.0
anchor_bottom=1.0
grow_horizontal=2
grow_vertical=2

[node name="Sea" type="ColorRect" parent="Backdrop"]
layout_mode=1
anchors_preset=15
anchor_right=1.0
anchor_bottom=1.0
color=Color(0.09,0.247,0.329,1)
mouse_filter=2

[node name="Center" type="CenterContainer" parent="Backdrop"]
layout_mode=1
anchors_preset=15
anchor_right=1.0
anchor_bottom=1.0

[node name="Content" type="VBoxContainer" parent="Backdrop/Center"]
layout_mode=2
theme_override_constants/separation=25

[node name="Eyebrow" type="Label" parent="Backdrop/Center/Content"]
layout_mode=2
theme_override_colors/font_color=Color(0.941,0.796,0.522,1)
theme_override_font_sizes/font_size=18
text="CAS  /  FULL-SCREEN TRANSITION GALLERY"
horizontal_alignment=1

[node name="Heading" type="Label" parent="Backdrop/Center/Content"]
layout_mode=2
theme_override_font_sizes/font_size=42
text="欢迎回港，指挥官。"
horizontal_alignment=1

[node name="Caption" type="Label" parent="Backdrop/Center/Content"]
layout_mode=2
theme_override_colors/font_color=Color(0.68,0.82,0.85,1)
text="这是一间不写入存档的转场演示室。"
horizontal_alignment=1

[node name="Buttons" type="HBoxContainer" parent="Backdrop/Center/Content"]
layout_mode=2
theme_override_constants/separation=20
alignment=1

[node name="CloudWave" type="Button" parent="Backdrop/Center/Content/Buttons"]
custom_minimum_size=Vector2(150,64)
layout_mode=2
text="云浪擦除"

[node name="CircularIris" type="Button" parent="Backdrop/Center/Content/Buttons"]
custom_minimum_size=Vector2(150,64)
layout_mode=2
text="圆形揭幕"

[node name="PaperSails" type="Button" parent="Backdrop/Center/Content/Buttons"]
custom_minimum_size=Vector2(150,64)
layout_mode=2
text="斜向帆片"

[node name="ReducedMotion" type="CheckButton" parent="Backdrop/Center/Content"]
layout_mode=2
size_flags_horizontal=4
text="减少动态：立即切换"

[node name="EditorHint" type="Label" parent="Backdrop/Center/Content"]
layout_mode=2
theme_override_colors/font_color=Color(0.65,0.76,0.78,1)
theme_override_font_sizes/font_size=16
text="编辑 PageTransition 的色彩、时长和小人开关；Timeline 内可预览遮盖曲线。"
horizontal_alignment=1

[node name="PageTransition" parent="." instance=ExtResource("2_transition")]
full_screen_wipe=true
