  "conflicts": [
    {"id":"fletcher-mk15-variant","status":"resolved_by_dated_forms","detail":"All five named dated forms list the 87-DP TNT torpedo. Annex F-1 also offers 99-DP Torpex from 1943 but gives no ship-specific assignment here."},
    {"id":"fletcher-gun-table","status":"resolved_by_annex","detail":"Old forms print 18/13/12/10 damage for SpCOM; Annex C-2 gives 18/14/12/11. Use the matched Annex C-2 gun row; do not splice shells."},
    {"id":"yugumo-gun-table","status":"resolved_by_annex","detail":"Dated forms print 12.7cm/50 mount names with the 12cm/45 range pattern. The identified 12.7cm/50 Annex C-1 rows control."},
    {"id":"fubuki-damage","status":"resolved_by_annex","detail":"1936 Fubuki Annex A-27 prints 106 DP. Dated Amagiri and Yugiri Form 10s print 139 DP; the explicit 1936-refit annex row is retained, with no additional -15% applied."},
    {"id":"fubuki-torpedo-reserve","status":"unresolved","detail":"Annex A-26 mount row lists 3 reserves for center mount with a 15-minute reload but the remark says no spares. Both dated Form 10s show reload marks on all three mounts. None of these alternatives is activated."},
    {"id":"yugiri-type22-date","status":"unresolved","detail":"Annex A-26 lists Type 22 during August-November 1943 refit but gives no exact completion day; the November dated Form 10 gives no radar. Type 22 is a candidate only."},
    {"id":"uzuki-torpedo-model","status":"unresolved","detail":"Annex A-27 class fit has 8th Year Type No. 2, without a dated replacement; the October 1943 Form 10 prints Type 93 data. Neither is selected."},
    {"id":"troop-loadout","status":"unresolved","detail":"Rising Sun PDF 92 provides group orders rather than initial named-ship cargo; troops may change loadout per PDF 93. Full mount capacity is distinct from scenario ammunition actually embarked."}
